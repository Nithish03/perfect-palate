# Perfect Palate environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string.
# - Local development:  mongodb://127.0.0.1:27017/perfect-palate
# - MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/perfect-palate
#   (create a free cluster at https://www.mongodb.com/cloud/atlas, add a
#   database user under Database Access, and allow your server's IP under
#   Network Access)
MONGODB_URI=mongodb://127.0.0.1:27017/perfect-palate

# Secret used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Port the HTTP server listens on (most hosts set this for you).
PORT=3000

# Set to "production" on your hosting platform. Enables secure cookies
# and requires SESSION_SECRET.
# NODE_ENV=production

# Only if your host terminates TLS in a way that breaks secure cookies
# and you cannot fix it at the proxy level (leave unset normally).
# INSECURE_COOKIES=true
